# Local development only. Change the password before using outside your machine.
DB_NAME=mailai
DB_USERNAME=mailai
DB_PASSWORD=change-this-local-password
DB_URL=jdbc:postgresql://localhost:5432/mailai
# Optional for certificate-verified PostgreSQL TLS (Aiven): set DB_URL sslmode=verify-full
# and point this to the provider's CA PEM file. In Cloud Run, mount it from Secret Manager.
DB_SSL_ROOT_CERT=
SPRING_PROFILES_ACTIVE=postgres
# For local QStash, the callback URL defaults to http://localhost:<selected backend port>.
# Set this to the public HTTPS origin in a deployed environment.
# Locally, leave PUBLIC_BASE_URL unset; it follows the Spring port selected at startup.
# In deployment, set it to the app's public HTTPS origin.
# PUBLIC_BASE_URL=https://your-public-app.example
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Leave unset to use the selected backend port. Register callback URLs for ports 8080, 8081, and 8082 in Google Cloud.
# GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
FRONTEND_BASE_URL=http://localhost:4201
FRONTEND_ORIGIN=http://localhost:4201
# For local development, leave the session cookie settings at these defaults.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
# On Cloud Run, set both cookie variables for the cross-site Vercel -> Cloud Run session.
# SESSION_COOKIE_SAME_SITE=None
# SESSION_COOKIE_SECURE=true
# Set FRONTEND_BASE_URL and FRONTEND_ORIGIN to the exact deployed Vercel origin in Cloud Run.
# Generate 32 random bytes and Base64-encode them for AES-256-GCM token encryption.
TOKEN_ENCRYPTION_KEY=
# AI conversation storage: use local MongoDB at localhost:27017.
CHAT_STORE=mongo
CHAT_PROPOSAL_STORE=jpa
MONGODB_URI=mongodb://localhost:27017/mailai_chat
AI_PROVIDER=bedrock-converse
AWS_REGION=us-east-1
# Add your Amazon Bedrock bearer token to .env; never commit the real token.
AWS_BEARER_TOKEN_BEDROCK=
AI_MODEL=us.anthropic.claude-sonnet-4-6
QSTASH_ENABLED=false
# Spring callback address QStash will call; use the port Spring actually starts on.
QSTASH_URL=http://localhost:8080
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
